<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_website_mail_server" model="res.groups">
        <field name="name">Website Mail Server Manager</field>
        <field name="category_id" ref="base.module_category_website"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="mail_mail_website_rule" model="ir.rule">
        <field name="name">Allow website mail creation</field>
        <field name="model_id" ref="mail.model_mail_mail"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_website_mail_server'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
